	path = MikuEngine/vendor/gli
	url = https://github.com/g-truc/gli.git
[submodule "Imgui-Cmake"]
	path = MikuEngine/vendor/imgui
	url = git@github.com:staticaron/imgui-cmake.git
[submodule "MikuEngine/vendor/ImGuizmo"]
	path = MikuEngine/vendor/ImGuizmo
	url = git@github.com:staticaron/ImGuizmo-Cmake.git
[submodule "MikuEngine/vendor/glad"]
