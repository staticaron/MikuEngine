[submodule "MikuEngine/vendor/glfw"]
	path = MikuEngine/vendor/glfw
	url = https://github.com/glfw/glfw.git
[submodule "MikuEngine/vendor/spdlog"]
	path = MikuEngine/vendor/spdlog
	url = https://github.com/gabime/spdlog.git
[submodule "MikuEngine/vendor/glm"]
	path = MikuEngine/vendor/glm
	url = https://github.com/g-truc/glm.git
[submodule "MikuEngine/vendor/entt"]
	path = MikuEngine/vendor/entt
	url = https://github.com/skypjack/entt.git
[submodule "MikuEngine/vendor/yaml-cpp"]
	path = MikuEngine/vendor/yaml-cpp
	url = https://github.com/jbeder/yaml-cpp.git
[submodule "MikuEngine/vendor/nativefiledialog"]
	path = MikuEngine/vendor/nativefiledialog
	url =  git@github.com:staticaron/nativefiledialog-cmake.git
	ignore = dirty
[submodule "MikuEngine/vendor/dylib"]
	path = MikuEngine/vendor/dylib
